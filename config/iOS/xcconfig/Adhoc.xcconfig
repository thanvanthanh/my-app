//// Common Configuration
#include "config/iOS/xcconfig/Common.xcconfig"

//// App target bundle identifier
AS_BUNDLE_IDENTIFIER = com.thanhthan.adhoc.ios
/// Notification Service target bundle identifier
AS_BUNDLE_ID_NOTIFSERV = com.thanhthan.adhoc.ios.notificationservice
/// Notification Content target bundle identifier
AS_BUNDLE_ID_NOTIFCONTENT = com.thanhthan.adhoc.ios.notificationcontent

/// App Name
AS_APP_NAME = my-app Adhoc
/// App Icon
AS_APP_ICON = AppIcon Adhoc
/// ProjectEnvironment
AS_APP_ENVIRONMENT = Adhoc
