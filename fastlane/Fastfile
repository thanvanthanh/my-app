platform :ios do
  desc "Deploy an ad hoc build"
  lane :deploy_adhoc do
    deploy_ios(export_method: "ad-hoc", upload_to_testflight: false)
  end

  desc "Deploy a beta build to TestFlight"
  lane :deploy_beta do
    deploy_ios(export_method: "app-store", upload_to_testflight: true)
  end

  desc "Deploy a release build to TestFlight"
  lane :deploy_release do
    deploy_ios(export_method: "app-store", upload_to_testflight: true)
  end

  private_lane :deploy_ios do |options|
    ensure_required_environment(include_testflight: options[:upload_to_testflight])
    ensure_git_status_clean

    match(
      username: ENV["USERNAME"],
      team_id: ENV["TEAM_ID"],
      type: options[:export_method] == "ad-hoc" ? "adhoc" : "appstore",
      git_branch: ENV["CERTIFICATES_BRANCH"],
      clone_branch_directly: true,
      app_identifier: ENV["BUNDLE_ID"]
    )

    build_app(
      project: ENV.fetch("XCODEPROJ", "./my-app.xcodeproj"),
      scheme: ENV["SCHEME"],
      configuration: ENV["CONFIGURATION"],
      export_method: options[:export_method],
      skip_profile_detection: true,
      output_directory: "./fastlane_output/",
      output_name: "my-app_#{ENV['VERSION']}",
      clean: true
    )

    if options[:upload_to_testflight]
      upload_to_testflight(
        username: ENV["USERNAME"],
        apple_id: ENV["APPLE_ID"],
        app_identifier: ENV["BUNDLE_ID"],
        skip_submission: true,
        distribute_external: false,
        skip_waiting_for_build_processing: true
      )
    end
  end
end

def ensure_required_environment(include_testflight:)
  required = %w[USERNAME TEAM_ID CERTIFICATES_BRANCH BUNDLE_ID SCHEME CONFIGURATION VERSION]
  required << "APPLE_ID" if include_testflight
  missing = required.select { |key| ENV[key].to_s.empty? }
  UI.user_error!("Missing environment variables: #{missing.join(', ')}") unless missing.empty?
end

after_all do |lane|
  notification(subtitle: "fastlane finished '#{lane}'", message: "Ready for the next step!")
end

error do |lane|
  notification(subtitle: "fastlane failed '#{lane}'", message: ":(")
end
